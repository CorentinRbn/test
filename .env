# --- Base de données ---
MYSQL_ROOT_PASSWORD=root
DB_NAME=dvwa
DB_USER=dvwa
DB_PASSWORD=user

# --- Réseau ---
WEB_PORT=8080

# --- DVWA ---
# Niveau de sécurité DVWA: low|medium|high|impossible (valeur par défaut: low)
DVWA_SECURITY=low
# Permet de créer les tables au démarrage (1) ou non (0)
DVWA_SETUP_CREATE_DB=1
